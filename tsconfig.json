{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["server", "src", "tests"],
  // The Worker entry and its Durable Object use Cloudflare's runtime types: tsconfig.worker.json checks them.
  "exclude": ["server/worker.ts", "server/limiter-do.ts"]
}
