{
  "name": "market-context-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "rm -rf dist/client && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "wrangler types --include-env=false && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "playwright test",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/yrsa": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@nova-caelum/ui": "file:./vendor/nova-caelum-ui",
    "@tradingview/lwc-plugin-brushable-area-series": "1.0.0",
    "hono": "^4.13.13",
    "lightweight-charts": "5.2.1",
    "motion": "^12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "4.151.1"
